# Simple AUV hull: a rectangular body with a tapered nose cone.
# Authored in meters, centered on the vehicle CoG (origin), +X forward.
# Referenced by torpedo_auv.yaml as a demo of mesh vehicle rendering.
v -0.45 -0.15 -0.125
v -0.45  0.15 -0.125
v -0.45  0.15  0.125
v -0.45 -0.15  0.125
v  0.35 -0.15 -0.125
v  0.35  0.15 -0.125
v  0.35  0.15  0.125
v  0.35 -0.15  0.125
v  0.55  0.00  0.000
# stern cap
f 1 2 3
f 1 3 4
# bottom
f 1 5 6
f 1 6 2
# top
f 4 3 7
f 4 7 8
# port side
f 1 4 8
f 1 8 5
# starboard side
f 2 6 7
f 2 7 3
# nose cone (front rectangle to tip)
f 5 6 9
f 6 7 9
f 7 8 9
f 8 5 9
